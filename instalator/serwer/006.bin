-- Towarzysz: the player's own companion (playerbot_sidekick.h, Tieru,
-- 24 September). A letter at every login is the whole interface: before the
-- companion exists it asks for the class, the sex, the path and the name, and
-- afterwards it is the companion's menu - call it back, let it play on its
-- own, say how it fights, ask how it is, send it away.
--
-- The work is the server's /towarzysz command (cmd_general.cpp through
-- playerbotify.py): it picks one of the kingdom's seeded bot identities of the
-- race asked for, renames it, writes player.playerbot_sidekick and sets this
-- quest's flag "created" before the command returns, so the flag is the answer
-- to whether it worked. The command also answers in the chat, with the reason
-- when it refused (a name taken or not allowed, no free character of that
-- class). A bot that logs in reads the letter too; a bot's client does not
-- exist, and the command refuses a bot anyway.
--
-- The world may do without it: M2_SIDEKICK=0 in .env (the launcher's
-- difficulty window) is the event flag m2_sidekick_off, and then no letter is
-- sent, so nobody has the way in (Tieru, 25 September). A letter already in
-- the bag from before says so, and the server refuses the command anyway.
quest towarzysz begin
	state start begin
		when login begin
			if game.get_event_flag("m2_sidekick_off") == 0 then
				send_letter("Towarzysz")
			end
		end

		when button or info begin
			if game.get_event_flag("m2_sidekick_off") != 0 then
				say_title("Towarzysz")
				say("Towarzysze sa wylaczeni na tym serwerze.")
				say("Wlacza je wlasciciel serwera w launcherze")
				say("(poziom trudnosci swiata).")
				return
			end
			-- MT2009_PLUS_SIDEKICK_ROSTER_V1: a roster of companions - the
			-- first is made here as before, the next ones from the menu's
			-- "Nowy towarzysz" (the server refuses past the roster's size).
			local makeNew = pc.getqf("created") == 0
			if not makeNew then
				say_title("Towarzysz")
				say("Co mam zrobic?")
				say("")
				say("Polecenia ida do towarzysza wybranego w oknie")
				say("(klawisz P). Szeptem tez zrozumiem: chodz, graj sam,")
				say("czekaj, zakupy, stan, atakuj, nie atakuj pierwszy.")
				local m = select("Okno towarzysza (klawisz P)", "Druzyna i lawka (Alt+P)", "Przywolaj do mnie", "Graj po swojemu (wolna reka)", "Jak ma walczyc?", "Jak sie masz?", "Nowy towarzysz", "Odejdz na dobre", "Nic")
				if m == 1 then
					-- The window (uisidekick.py, client 2.0.33); an older client
					-- only writes an unknown command to its syserr.txt.
					cmdchat("SidekickWindow")
					return
				elseif m == 2 then
					-- uisidekickroster.py
					cmdchat("SidekickRosterWindow")
					return
				elseif m == 3 then
					command("towarzysz przywolaj")
					return
				elseif m == 4 then
					command("towarzysz wolny")
					return
				elseif m == 5 then
					say_title("Towarzysz")
					say("Jak mam walczyc przy tobie?")
					local w = select("Atakuje wszystko w poblizu", "Nie atakuje pierwszy", "Nie walcze, tylko sie bronie", "Bez zmian")
					if w <= 3 then
						command("towarzysz walka " .. (w - 1))
					end
					return
				elseif m == 6 then
					command("towarzysz stan")
					return
				elseif m == 7 then
					makeNew = true
				elseif m == 8 then
					say_title("Towarzysz")
					say("Na pewno? Wybrany towarzysz odejdzie, a jego postac")
					say("wroci do swiata jako zwykly bot. Nowego")
					say("mozesz wybrac od razu.")
					if select("Tak, odejdz", "Nie") == 1 then
						command("towarzysz odprawa tak")
					end
					return
				else
					return
				end
			end
			if makeNew then
				say_title("Towarzysz")
				say("Mozesz zabrac w droge stalego towarzysza: postac,")
				say("ktora jest z toba w grupie, expi z toba po rowno,")
				say("biega za toba, broni cie i zbiera twoj drop.")
				say("")
				say("Jaka ma byc jego klasa?")
				local c = select("Wojownik", "Ninja", "Sura", "Szaman", "Pozniej")
				if c == 5 then
					return
				end
				say_title("Towarzysz")
				say("Kobieta czy mezczyzna?")
				local s = select("Mezczyzna", "Kobieta")
				-- player.job: 0 warrior, 1 ninja, 2 sura, 3 shaman for the one sex
				-- the class was first made in, and the same plus four for the other.
				local male = { 0, 5, 2, 7 }
				local female = { 4, 1, 6, 3 }
				local race = male[c]
				if s == 2 then
					race = female[c]
				end
				say_title("Towarzysz")
				say("Jaka sciezka?")
				local g = 1
				if c == 1 then
					g = select("Cialo (Body)", "Umysl (Mental)")
				elseif c == 2 then
					g = select("Skrytobojca (sztylety)", "Lucznik (luk)")
				elseif c == 3 then
					g = select("Ostrze (Weaponry)", "Czarna Magia")
				else
					g = select("Smok (Dragon)", "Uzdrowienie (Heal)")
				end
				say_title("Towarzysz")
				say("Jak ma sie nazywac?")
				say("Od 3 do 16 liter i cyfr, bez spacji.")
				local name = input()
				if name == nil or name == "" then
					return
				end
				-- "made": the server's word that this one was made (the
				-- roster's first and every next one alike).
				pc.setqf("made", 0)
				command("towarzysz stworz " .. race .. " " .. g .. " " .. name)
				if pc.getqf("made") == 1 then
					say_title("Towarzysz")
					say(name .. " dolacza do twojej druzyny.")
					say("")
					say("Ten list zostaje: to menu twoich towarzyszy.")
					say("Okno towarzysza otwiera klawisz P, druzyne i lawke")
					say("Alt+P. Mozesz tez mu szepnac: chodz, graj sam,")
					say("czekaj, zakupy, stan.")
				end
				return
			end

		end
	end
end
